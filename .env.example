# Server
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Lichess
LICHESS_API_TOKEN=
TIME_TROUBLE_THRESHOLD_SECONDS=30.0

# Pacing Buffer
MAX_PACED_MOVE_DELAY_SECONDS=60.0
FAST_FORWARD_INITIAL_HISTORY=true

# Stockfish
STOCKFISH_PATH=C:/Users/PRINCE/Desktop/RAG/chess_engine/stockfish-windows-x86-64-universal/stockfish/stockfish-windows-x86-64-universal.exe
STOCKFISH_DEPTH=14
STOCKFISH_MOVETIME_MS=250
STOCKFISH_MULTIPV=3
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128

# Eval Swings
BLUNDER_THRESHOLD_CP=200
MISTAKE_THRESHOLD_CP=100
INACCURACY_THRESHOLD_CP=50

# LLM & TTS
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_ANALYST_VOICE_ID=
