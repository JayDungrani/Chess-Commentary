# ===================================================
# Live Chess Commentary Environment Configuration
# ===================================================

# LLM Configuration (Google Gemini) - Required for Commentary Generation
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs TTS Configuration - Required if audio commentary playback is enabled
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_HOST_VOICE_ID=D11AWvkESE7DJwqIVi7L
# ELEVENLABS_ANALYST_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Lichess Configuration - Optional (Increases rate limits for broadcast queries)
# LICHESS_API_TOKEN=your_lichess_personal_access_token

# Stockfish Engine Settings (Set automatically inside Docker container)
# STOCKFISH_PATH=/usr/games/stockfish
# STOCKFISH_DEPTH=14
# STOCKFISH_MOVETIME_MS=250
# STOCKFISH_THREADS=2
# STOCKFISH_HASH_MB=128